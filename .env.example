# DFSha Superpeer: Environment variables
# Copy this file to .env and adjust values for your environment


# HTTP port the superpeer listens on
PORT=8080

# Size in bytes of each file chunk (default: 4 MB)
CHUNK_SIZE=4194304

# Number of peers each chunk is replicated to (default: 2)
REPLICATION_FACTOR=2

# Seconds without a heartbeat before a peer is marked unhealthy (default: 15)
HEARTBEAT_TIMEOUT_SECONDS=15

# AES-256 encryption key 
# Generate a valid key:
#   openssl rand -hex 32

AES_KEY=your_generated_aes_key_here
